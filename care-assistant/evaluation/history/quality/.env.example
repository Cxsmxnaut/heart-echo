# Local demo only. Tokens stay on the server. Never put secrets in public/.
PORT=4318
# guided: useful public-data flow, NOT an LLM. compatible: real chat-completions endpoint.
LLM_PROVIDER=compatible
# Endpoint must implement OpenAI-compatible /chat/completions and tool_calls.
# Do not configure an endpoint you have not approved for the data you send.
LLM_BASE_URL=http://127.0.0.1:4320/v1
LLM_MODEL=care-gemma4-e4b
MODEL_VARIANT=e4b
LLM_TEMPERATURE=0
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
UPSTREAM_TIMEOUT_MS=12000
# Optional shared secret for native/CLI calls. Browser uses same-origin checks.
CARE_API_TOKEN=
