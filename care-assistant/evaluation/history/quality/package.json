{
  "name": "chest-bpm-care-assistant",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "mcp": "node --env-file-if-exists=.env src/mcp.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-test.js",
    "test:browser:live": "node scripts/browser-live.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "evaluate": "node --env-file-if-exists=.env evaluation/run.js",
    "schema": "node scripts/export-schema.js",
    "model:setup": "node --env-file-if-exists=.env scripts/setup-local-model.js",
    "model": "node --env-file-if-exists=.env scripts/start-local-model.js",
    "evaluate:quality": "node --env-file-if-exists=.env evaluation/quality-final.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "express": "^5.2.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "supertest": "^7.3.2"
  }
}
